# =====================================================================
# Transcribe_Ambient Pipeline Environment Configuration
# =====================================================================

# Default directory path to scan for audio files (can be overridden via CLI)
WATCH_DIRECTORY=./Files

# Local LLM Inference Engine Configuration
OLLAMA_HOST=127.0.0.1:11434
OLLAMA_MODEL=llama3

# Whisper Model Configuration (options: tiny, base, small, medium, large-v3)
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Heavy Hardware Dependency Toggles (Set to true if installed and configured)
ENABLE_DAVINCI_RESOLVE=false
ENABLE_UVR=false

# Source Classification & Renaming Rules (JSON file path)
SOURCES_CONFIG_PATH=sources_config.json